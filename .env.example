# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PortfolioPro JWT Configuration (uses sensible defaults in development if omitted)
JWT_ACCESS_SECRET="change_me_access_secret_at_least_32_characters"
JWT_REFRESH_SECRET="change_me_refresh_secret_at_least_32_characters"
