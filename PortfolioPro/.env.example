# MySQL 8 Database (uses 127.0.0.1:3307 to avoid conflicts with local MySQL on 3306)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=portfoliopro
DB_USER=portfolio_user
DB_PASSWORD=portfolio_pass
DB_ROOT_PASSWORD=rootpassword

# Spring Boot Server & JWT Secrets (256-bit minimum)
SERVER_PORT=8080
JWT_ACCESS_SECRET=PortfolioProSuperSecureAccessJwtKey2026ForNseTradingPlatform99!
JWT_REFRESH_SECRET=PortfolioProSuperSecureRefreshJwtKey2026ForNseTradingPlatform99!
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Frontend Origin
CORS_ALLOWED_ORIGINS=http://localhost:4200
